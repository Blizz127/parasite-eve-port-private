typedef struct {
    short vx;
    short vy;
    short vz;
    short pad;
} SV;

typedef struct {
    int a;
    int b;
} W8;

void func_800D3AFC(SV *a0, short n, SV *src, int mode)
{
    int i;
    W8 *p;

    if (mode != 0) {
        for (i = 0; i < (short)(n + 1); i++) {
            a0[i].vx = src->vx;
            a0[i].vy = src->vy;
            a0[i].vz = src->vz;
        }
        return;
    }
    p = (W8 *)&a0[n - 1];
    for (i = 0; i < n; i++) {
        p[1].a = p[0].a;
        p[1].b = p[0].b;
        p--;
    }
    ((W8 *)a0)->a = ((W8 *)src)->a;
    ((W8 *)a0)->b = ((W8 *)src)->b;
}
